# Database — SQLite (default) or PostgreSQL for persistent storage
DATABASE_URL=sqlite:///./sentiment_platform.db

# HuggingFace model cache directory
MODEL_CACHE_DIR=./model_cache

# Inference device: cpu | cuda | auto
DEVICE=cpu

# Max characters per text input
MAX_TEXT_LENGTH=512

# CORS — set as a JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","https://your-app.vercel.app"]

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# YouTube Data API v3 key (required for YouTube URL analysis)
YOUTUBE_API_KEY=

# Instagram credentials (required for Instagram URL analysis)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
INSTAGRAM_SESSION_ID=
